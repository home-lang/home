{
  "name": "@home/exports",
  "exports": {
    ".": {
      "import": "./import.cjs",
      "require": "./require.cjs"
    },
    "./cache": {
      "types": "./absent.d.ts",
      "import": "./cache.cjs"
    },
    "./feature/*": {
      "import": "./features/*.cjs",
      "require": "./require.cjs"
    },
    "./feature/special/*": "./special.cjs",
    "./feature/*.json": "./json.cjs",
    "./exact": "./exact.cjs",
    "./*": "./fallback.cjs",
    "./blocked": null,
    "./private/*": null,
    "./nested": {
      "node": {
        "unused": "./absent.cjs"
      },
      "default": "./nested.cjs"
    },
    "./ordered": {
      "default": "./default.cjs",
      "require": "./absent.cjs"
    },
    "./array": [
      "../escape.cjs",
      null,
      {
        "unused": "./absent.cjs"
      },
      "./array.cjs"
    ],
    "./missing-array": [
      "./missing.cjs",
      "./fallback.cjs"
    ],
    "./extensionless": "./cache",
    "./directory": "./features",
    "./bad": "../escape.cjs",
    "./traversal": "./features/../cache.cjs",
    "./encoded": "./%2e%2e/escape.cjs",
    "./encoded-separator": "./features%2fcache.cjs",
    "./invalid-value": 42,
    "./asset": "./asset.txt",
    "./self": "./self.cjs",
    "./require-only": {
      "require": "./require.cjs"
    },
    "./named": {
      "import": "./named.mjs"
    }
  },
  "main": "./fallback.cjs"
}
