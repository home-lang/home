pub fn exported(value: i32) -> i32 {
    return value
}

export const EXPORTED_VALUE: i32 = 7

fn hidden() -> i32 {
    return 0
}

fn hidden_with_argument(value: i32) -> i32 {
    return value
}

pub struct Counter {
    value: i32

    pub fn add(self, amount: i32) -> i32 {
        return self.value + amount
    }
}
